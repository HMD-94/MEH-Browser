{
  "manifest_version": 3,
  "name": "MEH Browser - Liquid Glass for Chrome",
  "version": "1.0.0",
  "description": "Transformez Google Chrome avec le design Liquid Glass officiel de MEH Browser : nouvel onglet spectaculaire, multi-moteurs, widgets et fonds 4K.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MEH Browser Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "omnibox": {
    "keyword": "meh"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.fr/search*",
        "*://www.google.be/search*",
        "*://www.google.ca/search*",
        "*://www.google.ch/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://duckduckgo.com/*",
        "*://www.bing.com/search*",
        "*://www.qwant.com/*",
        "*://www.ecosia.org/search*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "wallpapers/*",
        "icons/*"
      ],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.fr/*",
        "*://*.google.be/*",
        "*://*.google.ca/*",
        "*://*.google.ch/*",
        "*://*.google.co.uk/*",
        "*://*.google.de/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://duckduckgo.com/*",
        "*://*.bing.com/*",
        "*://*.qwant.com/*",
        "*://*.ecosia.org/*"
      ]
    }
  ]
}
